# SmartCV Environment Variables
# Copy this file to .env.local and fill in your values

# Chapa Payment Gateway
# Get your keys from https://dashboard.chapa.co
# For testing, use test mode keys. For production, switch to live keys.
CHAPA_SECRET_KEY=CHASECK_TEST_xxxxxxxxxxxxxxxxxxxx

# Optional: Webhook secret for verifying Chapa callbacks
# CHAPA_WEBHOOK_SECRET=your_webhook_secret_here
